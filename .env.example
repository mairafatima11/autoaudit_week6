# Copy to .env and fill in your own credentials. `.env` is gitignored;
# THIS file is committed, so it must never contain a real key.
#
# "mock" runs the whole pipeline with deterministic stub LLM clients and no
# network access — useful for tests and demos. "live" requires real keys.
AUTOAUDIT_MODE=mock

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AUTOAUDIT_DATA_DIR=./data
AUTOAUDIT_LOG_DIR=./logs

# Optional: enables live GitHub repository metadata on the Repository page.
# Public repos work without it, at a lower unauthenticated rate limit.
GITHUB_TOKEN=

# Optional: require this key on every /api/* request (except /api/health).
# Unset (default) = no auth. See docs/DEPLOYMENT.md.
AUTOAUDIT_API_KEY=

# Optional: per-agent provider overrides. Unset = defaults below.
SECURITY_AGENT_PROVIDER=groq
QUALITY_AGENT_PROVIDER=gemini
DOCUMENTATION_AGENT_PROVIDER=gemini
FIX_AGENT_PROVIDER=groq

# Optional: how many findings/symbols are folded into a single model
# request. Higher = fewer round trips, larger prompts. Live mode only.
# Security matters most here: `semgrep --config=auto` can return hundreds
# of findings on a mid-sized repo, and each one used to be its own request.
SECURITY_AGENT_BATCH_SIZE=8
QUALITY_AGENT_BATCH_SIZE=8
DOCUMENTATION_AGENT_BATCH_SIZE=8

# Optional: spacing and retry for live Gemini requests.
GEMINI_REQUEST_DELAY_MS=200
GEMINI_MAX_RETRIES=3

# Thinking controls. Which one applies is decided from GEMINI_MODEL:
#
#   Gemini 2.x  -> GEMINI_THINKING_BUDGET (integer token budget).
#                  2.5 Flash thinks by default; 0 turns it off.
#   Gemini 3.x  -> GEMINI_THINKING_LEVEL (minimal|low|medium|high).
#                  `thinkingBudget` is legacy there, `temperature`/`top_p`/
#                  `top_k` are deprecated, and sending both thinking fields
#                  in one request is a documented 400. The client sends only
#                  the pair valid for the configured model.
#
# Defaults differ per model: gemini-3.5-flash-lite already defaults to
# `minimal`, so there is no thinking overhead to remove there.
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=minimal
# Must stay comfortably above what one full batch needs, or the response is
# truncated mid-batch and can't be split back apart.
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_HTTP_TIMEOUT_SECONDS=90
